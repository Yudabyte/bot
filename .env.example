# Alamat website. Lokal: http://localhost:3000 — Online: https://domain-kamu.com
BASE_URL=http://localhost:3000
PORT=3000

# Isi bebas, string acak panjang (untuk mengamankan sesi login)
SESSION_SECRET=ganti-dengan-teks-acak-yang-panjang

# SMTP untuk mengirim OTP verifikasi pendaftaran.
# Gunakan kredensial SMTP provider email; untuk Gmail gunakan App Password, bukan password akun.
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=resend
SMTP_PASS=isi-password-atau-api-key-di-lingkungan-deployment
EMAIL_FROM=onboarding@resend.dev

# Kunci enkripsi token bot milik pengguna (32 byte dalam format hex)
# Buat dengan: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CREDENTIAL_ENCRYPTION_KEY=

# Zona waktu untuk {date} dan {time}
TIMEZONE=Asia/Jakarta

# (Opsional) batasi dashboard hanya untuk ID Discord tertentu, pisahkan dengan koma. Kosong = semua admin server boleh.
ALLOWED_USER_IDS=

# ID akun Discord pemilik website. Pemilik dapat memakai fitur owner-only pada dashboard.
OWNER_USER_IDS=
